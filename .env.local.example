# KloofStreet Street Pass - Environment Variables
# Copy this to .env.local in your repo root (DO NOT commit .env.local)
# Then add these same variables in Vercel > Settings > Environment Variables

# Supabase (used by /api/* serverless functions)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key

# Supabase Anon Key (embedded in index.html client-side code — see DEPLOY.md Step 3)
# SUPABASE_ANON_KEY=eyJ...your-anon-key

# Apple Wallet (optional, Phase 2)
# APPLE_PASS_CERT_P12=base64-encoded-p12
# APPLE_PASS_CERT_PASSWORD=your-cert-password
# APPLE_PASS_TEAM_ID=YOURTEAMID
# APPLE_PASS_TYPE_ID=pass.com.businesshustle.kloofstreet

# Google Wallet (optional, Phase 2)
# GOOGLE_WALLET_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# GOOGLE_WALLET_ISSUER_ID=your-issuer-id
